# paperpush submission file for ieee_tits  -*- mode: yaml -*-
# IEEE Transactions on Intelligent Transportation Systems
#
# Edit the values below, then run:  paperpush submit ieee_tits.sub
# Lines starting with '#' are comments and are ignored.

@venue: ieee_tits
# submission guide: https://ieee-itss.org/pub/t-its/

# Title (text, REQUIRED)
#   Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
title: 

# Abstract (textarea, REQUIRED)
#   150-250 words, one paragraph; no displayed equations, tables, abbreviations, footnotes or references. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
abstract: |
  

# Authors (authorlist, REQUIRED)
#   Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15). One per line: Name | email | affiliation | ORCID | corresponding (yes/no). Exactly one corresponding author. Author widgets are manual in the attended drivers.
authors: |
  

# Manuscript (file, REQUIRED)
#   IEEE double-column template, single-spaced. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
manuscript_file: 

# Main Document - LaTeX (file, optional)
#   Optional LaTeX submission route. Select this manuscript type yourself; archives require manual Select Main File confirmation. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-latex.html
latex_source_file: 

# Main Document - LaTeX PDF (file, optional)
#   Compiled PDF of the same LaTeX main document; required when source is supplied. manuscript_file may point to the same PDF. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-latex.html
latex_pdf_file: 

# Cover letter (file, optional)
#   Resubmissions of previously rejected papers must state the rejection history and the prior paper ID in the cover letter. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
cover_letter: 

# Figures (filelist, optional)
#   Optional additional files; labels/descriptions and upload dialogs are manual. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-manuscript.html
figure_files: |
  

# Supplementary files (filelist, optional)
#   Optional additional manuscript files; journal-specific categories are manual. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-manuscript.html
supplementary_files: |
  

# Portal Article Type (text, optional)
#   Copy an exact option from the journal portal. Options differ by journal; this is distinct from a configured preparation stage selector (article_type). Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_article-type.html
portal_article_type: 

# Conflict of interest statement (file, optional)
#   Map an existing statement only. The no-conflicts checkbox is an author declaration. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-manuscript.html
competing_interests_file: 

# Author response (revision) (file, optional)
#   Required by the documented revision workflow; revision applicability is confirmed manually. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-manuscript.html
author_response_file: 

# Title page (double anonymized) (file, optional)
#   When required by the selected peer review type. Confirm anonymity manually; use validate --anonymous for an arbitrary target. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_upload-manuscript.html
title_page_file: 

# Submission requirement confirmations (textarea, optional)
#   The author must review and check each journal-specific requirement. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_article-type.html
submission_requirements: |
  

# Additional Information declarations (textarea, optional)
#   Journal-specific questions, consent, licenses and payment choices require the author. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_additional-information.html
additional_information: |
  

# Peer review type (text, optional)
#   Author selects the review type if the journal permits; it may require replacing files. Source: https://rex-docs.atypon.com/ieee-rex/author_portal/t_auth_article-type.html
peer_review_type: 

# Article type (choice, REQUIRED)
#   Suggested length in IEEE style: Regular 10 pages, Short 6, Practitioner 6, Survey 18; up to 6 extra pages allowed with an overlength charge of $175 per extra page after acceptance. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
#   options: Regular | Short | Practitioner | Survey
article_type: 

# Free keywords (multichoice, optional)
#   Up to 2 free keywords. Enter comma-separated. At most 6 keywords in total: up to 2 free keywords, 1-2 from the methodology list and 1-2 from the application list. The official lists are not bundled; pick terms from the journal's lists. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
#   select 0-2, comma-separated
free_keywords: 

# Methodology keywords (multichoice, REQUIRED)
#   1-2 keywords from the T-ITS methodology list. Enter comma-separated. At most 6 keywords in total: up to 2 free keywords, 1-2 from the methodology list and 1-2 from the application list. The official lists are not bundled; pick terms from the journal's lists. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
#   select 1-2, comma-separated
methodology_keywords: 

# Application keywords (multichoice, REQUIRED)
#   1-2 keywords from the T-ITS application list. Enter comma-separated. At most 6 keywords in total: up to 2 free keywords, 1-2 from the methodology list and 1-2 from the application list. The official lists are not bundled; pick terms from the journal's lists. Source: https://ieee-itss.org/pub/t-its/ (page timestamp 2026-07-15).
#   select 1-2, comma-separated
application_keywords: 

